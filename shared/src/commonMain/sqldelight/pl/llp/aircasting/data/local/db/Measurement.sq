import kotlin.Boolean;
import kotlin.time.Instant;

CREATE TABLE measurements (
    stream_id INTEGER NOT NULL REFERENCES measurement_streams(id) ON DELETE CASCADE,
    time INTEGER AS Instant NOT NULL,
    value REAL NOT NULL,
    latitude REAL,
    longitude REAL,
    uploaded INTEGER AS Boolean NOT NULL DEFAULT 0,
    PRIMARY KEY (stream_id, time)
);

insertMeasurement:
INSERT OR IGNORE INTO measurements(stream_id, time, value, latitude, longitude)
VALUES (?, ?, ?, ?, ?);

selectRecentByStream:
SELECT *
FROM measurements
WHERE stream_id = :streamId
ORDER BY time DESC
LIMIT :limit;

selectLastTimeByStream:
SELECT time
FROM measurements
WHERE stream_id = :streamId
ORDER BY time DESC
LIMIT 1;

selectPendingUpload:
SELECT measurements.*
FROM measurements
JOIN measurement_streams ON measurement_streams.id = measurements.stream_id
WHERE measurement_streams.session_uuid = :sessionUuid AND measurements.uploaded = 0
ORDER BY measurements.time
LIMIT :limit;

markUploaded:
UPDATE measurements
SET uploaded = 1
WHERE stream_id = :streamId AND time = :time;