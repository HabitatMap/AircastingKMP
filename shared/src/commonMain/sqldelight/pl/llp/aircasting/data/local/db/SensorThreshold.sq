selectDefaults:
SELECT * FROM threshold_defaults;

selectAliases:
SELECT * FROM threshold_aliases;

selectOverrides:
SELECT * FROM threshold_overrides;

upsertOverride:
INSERT OR REPLACE INTO threshold_overrides (sensor_name, very_low, low, medium, high, very_high)
VALUES (?, ?, ?, ?, ?, ?);

deleteOverride:
DELETE FROM threshold_overrides WHERE sensor_name = :sensorName;

-- threshold_sets refresh: replaces defaults + aliases wholesale, inside one transaction.
deleteDefaults:
DELETE FROM threshold_defaults;

deleteAliases:
DELETE FROM threshold_aliases;

insertDefault:
INSERT INTO threshold_defaults (sensor_name, very_low, low, medium, high, very_high)
VALUES (?, ?, ?, ?, ?, ?);

-- OR REPLACE: if the server ever lists one spelling under two sets, last wins instead of aborting the refresh.
insertAlias:
INSERT OR REPLACE INTO threshold_aliases (alias, sensor_name) VALUES (?, ?);