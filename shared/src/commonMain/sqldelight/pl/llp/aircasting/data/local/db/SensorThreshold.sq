-- Thresholds are keyed by the canonical parameter name from GET /api/v3/threshold_sets
-- (`AirBeam-PM2.5`), not by model spelling (`AirBeamMini-PM2.5`): every model shares one entry.

-- Server defaults. What "Reset to default" goes back to.
CREATE TABLE threshold_defaults (
    sensor_name TEXT NOT NULL PRIMARY KEY,
    very_low INTEGER NOT NULL,
    low INTEGER NOT NULL,
    medium INTEGER NOT NULL,
    high INTEGER NOT NULL,
    very_high INTEGER NOT NULL
);

-- threshold_sets `aliases`: any sensor spelling -> its canonical sensor_name.
CREATE TABLE threshold_aliases (
    alias TEXT NOT NULL PRIMARY KEY,
    sensor_name TEXT NOT NULL
);

-- The user's slider edits. Local only, never uploaded; a defaults refresh never touches them.
CREATE TABLE threshold_overrides (
    sensor_name TEXT NOT NULL PRIMARY KEY,
    very_low INTEGER NOT NULL,
    low INTEGER NOT NULL,
    medium INTEGER NOT NULL,
    high INTEGER NOT NULL,
    very_high INTEGER NOT NULL
);

-- Bundled copy of GET /api/v3/threshold_sets (2026-11-04), so the first offline launch is coloured.
-- Seeded on DB creation only.
