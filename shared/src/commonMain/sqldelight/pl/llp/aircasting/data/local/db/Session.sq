import kotlin.Boolean;
import kotlin.String;
import kotlin.collections.List;
import kotlin.time.Instant;
import pl.llp.aircasting.domain.session.SessionStatus;
import pl.llp.aircasting.domain.session.SessionType;

CREATE TABLE sessions (
    uuid TEXT NOT NULL PRIMARY KEY,
    type TEXT AS SessionType NOT NULL,
    status TEXT AS SessionStatus NOT NULL,
    name TEXT NOT NULL,
    tags TEXT AS List<String> NOT NULL,
    device_id TEXT,
    device_model TEXT,
    start_time INTEGER AS Instant NOT NULL,
    end_time INTEGER AS Instant,
    latitude REAL,
    longitude REAL,
    is_indoor INTEGER AS Boolean NOT NULL DEFAULT 0,
    contribute INTEGER AS Boolean NOT NULL DEFAULT 1,
    time_zone TEXT NOT NULL,
    measurement_interval_millis INTEGER NOT NULL,
    session_token TEXT
);

insertSession:
INSERT INTO sessions(
    uuid, type, status, name, tags, device_id, device_model,
    start_time, end_time, latitude, longitude,
    is_indoor, contribute, time_zone, measurement_interval_millis, session_token
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectSessionByUuid:
SELECT *
FROM sessions
WHERE uuid = :uuid;

selectAllSessions:
SELECT *
FROM sessions
ORDER BY start_time DESC;

updateSessionStatus:
UPDATE sessions
SET status = :status
WHERE uuid = :uuid;

finishSession:
UPDATE sessions
SET status = :status, end_time = :endTime
WHERE uuid = :uuid;

deleteSession:
DELETE FROM sessions
WHERE uuid = :uuid;